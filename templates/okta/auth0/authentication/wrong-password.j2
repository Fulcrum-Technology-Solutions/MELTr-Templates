{# Documented Auth0 fp/database scenario. Uses schema-standard registry fields. #}
{%- set user = registry.get_random_user() -%}
{%- set device = registry.get_random_device() -%}
{%- set application = registry.get_random_service() -%}
{%- set event_time = now() -%}
{%- set utc_time = event_time | iso8601_utc -%}
{%- set event_id = fake.numerify(text='9' + '#' * 56) -%}
{{- {
  'date': utc_time[:-4] + 'Z',
  'type': 'fp',
  'description': 'Wrong email or password.',
  'connection': 'Username-Password-Authentication',
  'connection_id': 'con_ExampleLab01',
  'client_id': application['service_id'],
  'client_name': application['description'] or application['name'],
  'ip': device['ip_address'],
  'user_agent': 'Chrome 86.0.4240 / Mac OS X 10.15.6',
  'details': {'error': {'message': 'Wrong email or password.'}},
  'user_id': 'auth0|' + (user.get('user_id') or user['username']),
  'user_name': user['email'],
  'strategy': 'auth0',
  'strategy_type': 'database',
  'log_id': event_id,
  '_id': event_id,
  'isMobile': false
} | tojson -}}
