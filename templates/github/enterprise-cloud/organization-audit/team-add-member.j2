{%- set actor = registry.get_random_user() -%}
{%- set target = registry.get_random_user() -%}
{%- set org_name = (registry.get_organization_field('name') or 'example').lower().replace(' ', '-') -%}
{%- set team = fake.random_element(elements=['engineering', 'security', 'admins', 'developers']) -%}
{%- set clock = now() -%}
{%- set milliseconds = ((clock | unix_timestamp) | int) * 1000 + clock.microsecond // 1000 -%}
{{- {'@timestamp': milliseconds, 'action': 'team.add_member', 'actor': actor['username'], 'created_at': milliseconds, '_document_id': fake.lexify(text='??????????????????????', letters='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_'), 'org': org_name, 'team': org_name + '/' + team, 'user': target['username']} | tojson -}}
