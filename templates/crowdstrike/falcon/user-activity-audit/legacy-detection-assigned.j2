{%- set user = registry.get_random_user() -%}
{%- set device = registry.get_random_device() -%}
{%- set clock = now() -%}
{%- set sec = (clock | unix_timestamp) | int -%}
{%- set ms = ((clock | unix_timestamp) * 1000) | int -%}
{#- CrowdStrike CID is 32-char lowercase hex (not a dashed UUID) -#}
{%- set cid = random_string(32, '0123456789abcdef') -%}
{%- set detection_id = 'ldt:' ~ random_string(32, '0123456789abcdef') ~ ':' ~ fake.pyint(min_value=100000000000, max_value=999999999999) -%}
{{- {'metadata': {'customerIDString': cid, 'offset': fake.pyint(min_value=1,max_value=2147483647), 'eventType': 'UserActivityAuditEvent', 'eventCreationTime': sec * 1000, 'version': '1.0'}, 'event': {'UserId': user['email'], 'UserIp': device['ip_address'], 'OperationName': 'detection_update', 'ServiceName': 'detections', 'AuditKeyValues': [{'Key': 'detection_id', 'ValueString': detection_id}, {'Key': 'new_state', 'ValueString': 'in_progress'}, {'Key': 'assigned_to', 'ValueString': user['full_name']}, {'Key': 'assigned_to_uid', 'ValueString': user['email']}], 'UTCTimestamp': sec}} | tojson -}}
