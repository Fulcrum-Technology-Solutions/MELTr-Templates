{# GitLab documented single-event API profile. Uses schema-standard registry fields. #}
{%- set author = registry.get_random_user() -%}
{%- set device = registry.get_random_device() -%}
{%- set project_path = author['username'] + '/' + fake.random_element(elements=['app', 'api', 'infra', 'docs']) -%}
{%- set event_time = now() | iso8601_utc -%}
{%- set event_id = fake.pyint(min_value=1000000000, max_value=2000000000) -%}
{%- set author_id = fake.pyint(min_value=1, max_value=99999) -%}
{%- set project_id = fake.pyint(min_value=1, max_value=99999) -%}
{{- {
  'id': event_id,
  'author_id': author_id,
  'entity_id': project_id,
  'entity_type': 'Project',
  'details': {
    'custom_message': 'Project archived',
    'author_name': author['full_name'],
    'author_email': author['email'],
    'target_id': project_path,
    'target_type': 'Project',
    'target_details': project_path,
    'ip_address': device['ip_address'],
    'entity_path': project_path
  },
  'created_at': event_time[:-4] + 'Z'
} | tojson -}}
