{%- set eventVersion = ['1.08', '1.10'] | random -%}
{%- set identity_type = ['IAMUser', 'AssumedRole'] | random -%}
{%- set account_id = random_int(100000000000, 999999999999) -%}
{%- set user = registry.get_random_user() -%}
{%- set username = user.username if user else "admin" -%}
{%- set domain = registry.get_organization_field('domain') | default("example.com") -%}
{%- set id_alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789' -%}
{%- set role_id = 'AROA' ~ random_string(17, id_alphabet) -%}
{%- set iam_user_id = 'AIDA' ~ random_string(17, id_alphabet) -%}
{%- set session_name = username ~ '@' ~ domain -%}
{%- set principal_id = iam_user_id if identity_type == 'IAMUser' else (role_id ~ ':' ~ session_name) -%}
{%- set role_name = ['AdminRole', 'SecurityRole', 'CloudTrailAdminRole', 'OrganizationAccountAccessRole'] | random -%}
{%- set trail_name = ['security-audit', 'compliance-trail', 'management-events', 'data-events', 'test-trail'] | random -%}
{%- set has_error = random_int(0, 8) -%}
{%- set error_codes = ['TrailNotFoundException', 'InvalidTrailNameException', 'AccessDenied'] -%}
{%- set error_code = error_codes | random if has_error == 1 else '' -%}
{%- set user_arn = "arn:aws:" ~ ("iam::" ~ account_id ~ ":user/" ~ username if identity_type == 'IAMUser' else "sts::" ~ account_id ~ ":assumed-role/" ~ role_name ~ "/" ~ session_name) -%}
{%- set aws_regions = ['us-east-1', 'us-east-2', 'us-west-1', 'us-west-2', 'eu-west-1', 'eu-central-1', 'ap-southeast-1'] -%}
{%- set current_region = aws_regions | random -%}
{%- set event_dt = current_timestamp() -%}
{%- set creation_date = (event_dt | subtract_seconds(random_int(300, 7200)) | iso8601_utc(false)) | replace('-', '') | replace(':', '') -%}
{%- set user_agents = [
  'aws-cli/2.0.62 Python/3.9.2 Darwin/21.5.0 source/x86_64 command/cloudtrail.delete-trail',
  'aws-cli/2.1.34 Python/3.8.5 Linux/5.4.0-74-generic source/x86_64 command/cloudtrail.delete-trail',
  'aws-sdk-go/1.40.2 (go1.17.1; linux; amd64) APN/1.0 HashiCorp/1.0 Terraform/1.0.5 (+https://www.terraform.io)',
  'console.amazonaws.com',
  'aws-sdk-python/1.26.0 Python/3.9.7 Linux/5.4.0-81-generic botocore/1.29.0',
  'stratus-red-team_' ~ random_guid()
] -%}
{%- set user_agent = user_agents | random -%}
{%- set from_console = user_agent == 'console.amazonaws.com' -%}
{%- set access_key_prefix = 'AKIA' if identity_type == 'IAMUser' else 'ASIA' -%}
{%- set access_key_id = access_key_prefix ~ random_string(16, id_alphabet) -%}
{%- set tls_version = ['TLSv1.2', 'TLSv1.3'] | random -%}
{%- set tls_cipher = (['ECDHE-RSA-AES128-GCM-SHA256', 'ECDHE-RSA-AES256-GCM-SHA384'] if tls_version == 'TLSv1.2' else ['TLS_AES_128_GCM_SHA256', 'TLS_AES_256_GCM_SHA384']) | random -%}
{
  "eventVersion": "{{ eventVersion }}",
  "userIdentity": {
    "type": "{{ identity_type }}",
    "principalId": "{{ principal_id }}",
    "arn": "{{ user_arn }}",
    "accountId": "{{ account_id }}",
    "accessKeyId": "{{ access_key_id }}",
    {% if identity_type == 'IAMUser' -%}
    "userName": "{{ username }}"
    {%- else -%}
    "sessionContext": {
      "sessionIssuer": {
        "type": "Role",
        "principalId": "{{ role_id }}",
        "arn": "arn:aws:iam::{{ account_id }}:role/{{ role_name }}",
        "accountId": "{{ account_id }}",
        "userName": "{{ role_name }}"
      },
      "webIdFederationData": {},
      "attributes": {
        "mfaAuthenticated": "{{ ['true', 'false'] | random }}",
        "creationDate": "{{ creation_date }}"
      }
    }
    {%- endif %}
  },
  "eventTime": "{{ event_dt | iso8601_utc(false) }}",
  "eventSource": "cloudtrail.amazonaws.com",
  "eventName": "DeleteTrail",
  "awsRegion": "{{ current_region }}",
  "sourceIPAddress": "{{ random_public_ip() }}",
  "userAgent": "{{ user_agent }}",
  {% if has_error == 1 -%}
  "errorCode": "{{ error_code }}",
  "errorMessage": "{% if error_code == 'TrailNotFoundException' %}Unknown trail: {{ trail_name }} for the user account.{% elif error_code == 'InvalidTrailNameException' %}Trail name {{ trail_name }} is invalid.{% elif error_code == 'AccessDenied' %}User: {{ user_arn }} is not authorized to perform: cloudtrail:DeleteTrail on resource: {{ trail_name }} with an explicit deny{% endif %}",
  {%- endif %}
  "requestParameters": {
    "name": "{{ trail_name }}"
  },
  "responseElements": null,
  "requestID": "{{ random_guid() }}",
  "eventID": "{{ random_guid() }}",
  "readOnly": false,
  "eventType": "AwsApiCall",
  "managementEvent": true,
  "recipientAccountId": "{{ account_id }}",
  "eventCategory": "Management"{% if from_console %},
  "sessionCredentialFromConsole": "true"
  {% else %},
  "tlsDetails": {
    "tlsVersion": "{{ tls_version }}",
    "cipherSuite": "{{ tls_cipher }}",
    "clientProvidedHostHeader": "cloudtrail.{{ current_region }}.amazonaws.com"
  }
  {% endif %}
}
