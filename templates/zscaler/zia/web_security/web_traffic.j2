{#-
  Zscaler ZIA web NSS fields — native Nanolog Streaming Service token names.
  Source: https://help.zscaler.com/zia/nss-feed-output-format-web-logs
  (not Splunk TA remaps such as ClientIP / event_id / hostname / urlcategory)
-#}
{%- set user = registry.get_random_user() -%}
{%- set device = registry.get_random_device() -%}
{%- set org_domain = registry.get_organization_field('domain') or 'example.com' -%}
{%- set clock = now() -%}
{%- set epoch = (clock | unix_timestamp) | int -%}
{%- set months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] -%}
{%- set days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'] -%}
{%- set time_str = days[clock.weekday()] + ' ' + months[clock.month - 1] + ' ' + (clock | strftime('%d %H:%M:%S %Y')) -%}
{%- set has_threat = [true, false, false, false, false, false] | random -%}
{%- set action = 'Blocked' if has_threat else 'Allowed' -%}
{%- set reqmethod = ['GET', 'POST', 'PUT', 'DELETE', 'HEAD', 'CONNECT', 'OPTIONS'] | random -%}
{%- set proto = ['HTTP', 'HTTPS'] | random -%}
{%- set host = fake.random_element(elements=['www', 'api', 'cdn', 'mail', 'docs']) + '.' + org_domain -%}
{%- set url_path = ['/', '/login', '/index.html', '/api/v1/users', '/resources/doc.pdf', '/favicon.ico'] | random -%}
{%- set url = host + url_path -%}
{%- set referer = 'www.google.com/' -%}
{%- set reqsize = random_int(200, 5000) -%}
{%- set respsize = random_int(500, 50000) -%}
{%- set reqhdrsize = 200 -%}
{%- set resphdrsize = 300 -%}
{%- set reqdatasize = [0, reqsize - reqhdrsize] | max -%}
{%- set respdatasize = [0, respsize - resphdrsize] | max -%}
{%- set urlcat = [
  'Business and Economy', 'Computers and Internet', 'Social Networking',
  'News and Media', 'Education', 'Entertainment', 'Shopping and Auctions',
  'Travel', 'Finance', 'Government'
] | random -%}
{%- set urlsupercat = [
  'Business and Economy', 'Internet Communication', 'Social and Lifestyle',
  'News and Information', 'Education', 'Entertainment and Recreation'
] | random -%}
{%- set urlclass = ['Business Use', 'Bandwidth Loss', 'Productivity Loss', 'General Surfing'] | random -%}
{%- set appname = ['Web Browsing', 'Google', 'Microsoft Office Online', 'Salesforce', 'Box'] | random -%}
{%- set appclass = ['General Browsing', 'Sales and Marketing', 'File Sharing', 'Collaboration'] | random -%}
{%- set malwarecat = ['Adware', 'Trojan', 'Phishing', 'Spyware', 'Backdoor'] | random -%}
{%- set malwareclass = ['Malware', 'Advanced Threats', 'Sandbox'] | random -%}
{%- set threatname = [
  'HTML.Adware.Gen', 'JS:Trojan.Cryxos', 'Phishing.Generic', 'EICAR Test File'
] | random -%}
{%- set riskscore = 85 if has_threat else random_int(0, 40) -%}
{%- set threatseverity = 'Critical' if riskscore >= 90 else ('High' if riskscore >= 75 else ('Medium' if riskscore >= 46 else ('Low' if riskscore >= 1 else 'None'))) -%}
{%- set respcode = '403' if has_threat else (['200', '201', '301', '302', '304', '400', '401', '404', '500'] | random) -%}
{%- set reason = 'Virus/Spyware/Malware blocked' if has_threat else 'Allowed' -%}
{%- set ruletype = 'URL Filtering' if has_threat else 'None' -%}
{%- set rulelabel = 'URL_Filtering_1' if has_threat else 'None' -%}
{%- set location = user.location.city if user.location is defined and user.location.city is defined else 'Headquarters' -%}
{%- set ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36' -%}
{{- {
  'time': time_str,
  'tz': 'UTC',
  'epochtime': epoch,
  'recordid': random_int(1000000000000000000, 9223372036854775807),
  'login': user['email'],
  'dept': user.get('department') or 'Default Department',
  'cip': device['ip_address'],
  'cintip': random_public_ip(),
  'sip': '0.0.0.0' if has_threat else random_public_ip(),
  'host': host,
  'url': url,
  'referer': referer,
  'refererhost': 'www.google.com',
  'proto': proto,
  'reqmethod': reqmethod,
  'reqversion': '1.1',
  'respversion': '1.1',
  'reqsize': reqsize,
  'reqhdrsize': reqhdrsize,
  'reqdatasize': reqdatasize,
  'respsize': respsize,
  'resphdrsize': resphdrsize,
  'respdatasize': respdatasize,
  'totalsize': reqsize + respsize,
  'respcode': respcode,
  'ua': ua,
  'ua_token': 'Google Chrome (122.x)',
  'uaclass': 'Chrome',
  'contenttype': ['text/html', 'application/json', 'text/plain', 'image/png', 'application/javascript'] | random,
  'action': action,
  'reason': reason,
  'ruletype': ruletype,
  'rulelabel': rulelabel,
  'appname': appname,
  'appclass': appclass,
  'urlcat': urlcat,
  'urlsupercat': urlsupercat,
  'urlclass': urlclass,
  'location': location,
  'riskscore': riskscore,
  'threatname': threatname if has_threat else 'None',
  'threatseverity': threatseverity if has_threat else 'None',
  'malwarecat': malwarecat if has_threat else 'None',
  'malwareclass': malwareclass if has_threat else 'None',
  'bamd5': random_string(32, '0123456789abcdef') if has_threat else 'None',
  'filetype': 'None',
  'fileclass': 'None',
  'filename': 'None',
  'filesubtype': 'None',
  'bwclassname': 'Default',
  'bwrulename': 'Default',
  'bwthrottle': 'No',
  'throttlereqsize': 0,
  'throttlerespsize': 0,
  'dlpeng': 'None',
  'dlpdict': 'None',
  'dlpdicthitcount': 'None',
  'dlpidentifier': 0,
  'dlpmd5': 'None',
  'ssldecrypted': 'Yes' if proto == 'HTTPS' else 'No',
  'clienttlsversion': ['TLS1.2', 'TLS1.3'] | random if proto == 'HTTPS' else 'None',
  'clientsslcipher': ['ECDHE-RSA-AES256-GCM-SHA384', 'ECDHE-RSA-AES128-GCM-SHA256'] | random if proto == 'HTTPS' else 'None',
  'clientsslsessreuse': ['Yes', 'No'] | random if proto == 'HTTPS' else 'None',
  'srvtlsversion': ['TLS1.2', 'TLS1.3'] | random if proto == 'HTTPS' else 'None',
  'srvsslcipher': ['ECDHE-RSA-AES256-GCM-SHA384', 'ECDHE-RSA-AES128-GCM-SHA256'] | random if proto == 'HTTPS' else 'None',
  'serversslsessreuse': ['Yes', 'No'] | random if proto == 'HTTPS' else 'None',
  'srvcertchainvalpass': 'Yes' if proto == 'HTTPS' else 'None',
  'srvcertvalidationtype': 'Default' if proto == 'HTTPS' else 'None',
  'srvcertvalidityperiod': random_int(30, 730) if proto == 'HTTPS' else 0,
  'srvocspresult': 'None',
  'srvwildcardcert': ['Yes', 'No'] | random if proto == 'HTTPS' else 'None',
  'devicehostname': device['hostname'],
  'devicename': device['hostname'],
  'devicemodel': device.get('model') or 'None',
  'deviceostype': device.get('os_type') or 'None',
  'deviceosversion': device.get('os_version') or 'None',
  'deviceowner': user['email'],
  'deviceappversion': 'None',
  'mobappname': 'None',
  'mobappcat': 'None',
  'mobdevtype': 'None',
  'trafficredirectmethod': 'Zscaler Client Connector (Zscaler App)',
  'productversion': '6.2'
} | tojson -}}
