{%- set user = registry.get_random_user() -%}
{%- set client = registry.get_device(user['username'] + '-slack-client') -%}
{%- set org = registry.get_organization() -%}
{%- set browser = registry.get_service('slack-browser') -%}
{%- set identity = {'id': user['slack_id'], 'name': user['full_name'], 'email': user['email']} -%}
{{- {'id': fake.uuid4(), 'date_create': (now() | unix_timestamp) | int, 'action': 'user_login', 'actor': {'type': 'user', 'user': identity}, 'entity': {'type': 'user', 'user': identity}, 'context': {'location': {'type': 'enterprise', 'id': org['slack_enterprise_id'], 'name': org['name'], 'domain': org['slack_domain']}, 'ua': browser['user_agent'], 'session_id': fake.numerify(text='############'), 'ip_address': client['ip_address']}} | tojson -}}
